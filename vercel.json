{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/Teor(.*)Musical/notaspiano",
      "destination": "/practica/piano",
      "permanent": true
    },
    {
      "source": "/Teor(.*)Musical/notasviolin",
      "destination": "/practica/violin",
      "permanent": true
    },
    {
      "source": "/Teor(.*)Musical/Ritmo",
      "destination": "/practica/ritmo",
      "permanent": true
    },
    {
      "source": "/Teor(.*)Musical/sonidosynotas",
      "destination": "/material",
      "permanent": true
    },
    {
      "source": "/Teor(.*)Musical/hojas",
      "destination": "/practica/hojas",
      "permanent": true
    },
    {
      "source": "/Teor(.*)Musical/oido",
      "destination": "/practica/oido",
      "permanent": true
    },
    {
      "source": "/Teor(.*)Musical/practica.js",
      "destination": "/practica/comprobante.js",
      "permanent": true
    },
    {
      "source": "/practica/sonidos-y-notas",
      "destination": "/material",
      "permanent": true
    },
    {
      "source": "/metodolog([^i].*)a",
      "destination": "/metodologia",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/practica/hojas/:instrumento/:semana",
      "destination": "/practica/hojas"
    },
    {
      "source": "/practica/ritmo/:compas",
      "destination": "/practica/ritmo"
    },
    {
      "source": "/practica/oido/:ejercicio",
      "destination": "/practica/oido"
    },
    {
      "source": "/practica/partituras/:id",
      "destination": "/practica/partituras"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' https://script.google.com https://script.googleusercontent.com; worker-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
